# --- Настройки avito_parser (скопируйте в .env) ---

# Город по умолчанию для поиска (slug Avito, см. https://www.avito.ru/все_города)
DEFAULT_CITY=moskva

# Радиус «близости» в км: объявление ближе радиуса получает максимальный балл за удалённость
DISTANCE_RADIUS_KM=50

# Пауза между открытием страниц объявлений, сек (минимум/максимум — выбирается случайно)
PAGE_DELAY_MIN=2.0
PAGE_DELAY_MAX=5.0

# Сколько объявлений открывать для подробного парсинга (максимум за один поиск)
MAX_ITEMS=30

# Deep scan: 1 = дополнительно открывать каждое объявление (возраст аккаунта продавца,
# точные координаты, больше бейджей). Медленнее и выше риск блокировки.
DEEP_SCAN=0

# Порт сервера
PORT=8000
